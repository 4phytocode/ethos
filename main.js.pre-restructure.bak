// Ethos desktop display: homepage with right sidebar, journals with tags, light/dark toggle.
// Start with:  npm start   (or: npx electron .)

const { app, BrowserWindow } = require('electron');
const fs = require('fs');
const path = require('path');

const PAGE = `<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Ethos</title>
<style>
  :root { --bg: #ffffff; --fg: #000000; --muted: #6b6b6b; --line: #e0e0e0;
          --card: #f5f5f5; --hover: #ebebeb; }
  body.dark { --bg: #0a0a0a; --fg: #ffffff; --muted: #9a9a9a; --line: #222222;
              --card: #141414; --hover: #1e1e1e; }

  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--fg); }
  body { font-family: Helvetica, Arial, sans-serif; transition: background 0.25s, color 0.25s;
         overflow: hidden; user-select: none; }

  /* === Brand, top left === */
  .brand { position: fixed; top: 18px; left: 24px; display: flex; align-items: center; gap: 8px;
           font-size: 18px; font-weight: 700; z-index: 10; cursor: default; }

  /* === Right sidebar === */
  .sidebar { position: fixed; top: 0; right: 0; bottom: 0; width: 52px; display: flex;
             flex-direction: column; align-items: flex-end; justify-content: center;
             padding: 0 10px; gap: 6px; z-index: 10; }
  .sidebar-btn { height: 38px; min-width: 38px; border: 0; border-radius: 10px; background: var(--card);
                 color: var(--fg); font-family: inherit; font-size: 14px; font-weight: 600;
                 cursor: pointer; display: flex; align-items: center; justify-content: center;
                 padding: 0 12px; overflow: hidden; white-space: nowrap;
                 transition: min-width 0.2s ease, padding 0.2s ease, background 0.15s; }
  .sidebar-btn .full { display: none; margin-left: 8px; font-weight: 500; }
  .sidebar-btn:hover { min-width: 140px; background: var(--hover); }
  .sidebar-btn:hover .full { display: inline; }
  .sidebar-btn.active { background: var(--fg); color: var(--bg); }

  /* === Views === */
  .view { display: none; position: absolute; inset: 0; right: 52px; overflow-y: auto; }
  .view.active { display: flex; }

  /* === Homepage === */
  #home { flex-direction: column; padding: 80px 36px 180px; }
  #home h1 { font-size: 36px; font-weight: 700; margin: 0 0 8px; }
  #home .subtitle { font-size: 14px; color: var(--muted); margin: 0 0 32px; }

  /* Habit bar at bottom */
  .habit-bar { position: fixed; left: 0; right: 52px; bottom: 0; height: 140px;
               padding: 16px 36px; border-top: 1px solid var(--line); background: var(--bg); z-index: 5; }
  .habit-bar h2 { margin: 0; font-size: 15px; font-weight: 700; }
  .habit-bar p { margin: 6px 0 0; font-size: 13px; color: var(--muted); }

  /* === Journals list === */
  #journals { flex-direction: column; padding: 80px 36px 36px; gap: 16px; }
  #journals h1 { font-size: 28px; font-weight: 700; margin: 0; }
  .new-page-btn { align-self: flex-start; padding: 8px 20px; border: 1px dashed var(--line); border-radius: 8px;
                  background: transparent; color: var(--muted); font-family: inherit; font-size: 14px;
                  cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .new-page-btn:hover { border-color: var(--fg); color: var(--fg); }

  .pages-grid { display: flex; flex-wrap: wrap; gap: 12px; }
  .page-card { width: 180px; padding: 14px; border-radius: 10px; background: var(--card);
               cursor: pointer; position: relative; transition: background 0.15s; }
  .page-card:hover { background: var(--hover); }
  .page-card .name { font-size: 14px; font-weight: 600; margin: 0; overflow: hidden;
                     text-overflow: ellipsis; white-space: nowrap; }
  .page-card .tag-pill { display: inline-block; margin-top: 8px; padding: 2px 10px; border-radius: 999px;
                         font-size: 11px; font-weight: 600; color: #fff; }

  /* Right-click context menu */
  .ctx-menu { position: fixed; min-width: 120px; background: var(--card); border: 1px solid var(--line);
              border-radius: 8px; padding: 4px 0; z-index: 100; box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
  body.dark .ctx-menu { box-shadow: 0 4px 16px rgba(0,0,0,0.5); }
  .ctx-menu div { padding: 7px 14px; font-size: 13px; cursor: pointer; }
  .ctx-menu div:hover { background: var(--hover); }

  /* === Inside a journal page === */
  #journal-page { flex-direction: column; padding: 72px 48px 48px; }
  .jp-header { display: flex; align-items: center; margin-bottom: 4px; }
  .jp-title { font-size: 26px; font-weight: 700; border: 0; outline: none; background: transparent;
              color: var(--fg); font-family: inherit; width: 100%; padding: 0; }
  .jp-tag-row { display: flex; align-items: center; gap: 8px; min-height: 32px; margin-bottom: 12px; }
  .jp-tag-pill { display: inline-block; padding: 3px 12px; border-radius: 999px; font-size: 12px;
                 font-weight: 600; color: #fff; }

  /* Create-tag button */
  .create-tag-btn { position: relative; padding: 4px 12px; border: 1px dashed var(--line); border-radius: 999px;
                    background: transparent; color: var(--muted); font-family: inherit; font-size: 12px;
                    cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .create-tag-btn:hover { border-color: var(--fg); color: var(--fg); }
  .create-tag-tooltip { position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%);
                        white-space: nowrap; padding: 6px 14px; border-radius: 8px; background: var(--fg);
                        color: var(--bg); font-size: 12px; pointer-events: none;
                        opacity: 0; transition: opacity 0.2s ease; }
  .create-tag-btn:hover .create-tag-tooltip { opacity: 1; }

  /* Tag creation panel */
  .tag-panel { display: flex; flex-direction: column; gap: 10px; padding: 16px; border-radius: 14px;
               background: var(--card); width: 300px; margin-bottom: 8px;
               overflow: hidden; transform-origin: top left;
               opacity: 0; max-height: 0; transform: scale(0.95) translateY(-4px);
               transition: opacity 0.25s ease, max-height 0.3s ease, transform 0.25s ease, padding 0.3s ease;
               padding-top: 0; padding-bottom: 0; pointer-events: none; }
  .tag-panel.open { opacity: 1; max-height: 160px; transform: scale(1) translateY(0);
                    padding-top: 16px; padding-bottom: 16px; pointer-events: auto; }
  .tag-panel input { padding: 9px 14px; border: 0; border-radius: 10px;
                     background: var(--bg); color: var(--fg); font-family: inherit; font-size: 13px;
                     outline: none; transition: box-shadow 0.15s; }
  .tag-panel input:focus { box-shadow: 0 0 0 1.5px var(--fg); }
  .tag-colors { display: flex; gap: 8px; }
  .tag-color-opt { width: 24px; height: 24px; border-radius: 50%; border: 0; padding: 0;
                   display: flex; align-items: center; justify-content: center;
                   color: #ffffff; font-size: 12px; font-weight: 700; line-height: 1;
                   cursor: pointer; transition: box-shadow 0.15s, transform 0.15s; }
  .tag-color-opt:hover { transform: scale(1.15); }
  /* The selected swatch gets a white ring laid over the colour plus a tick, so the choice is
     legible on every colour in the row and against either theme. */
  .tag-color-opt.sel { transform: scale(1.12);
                       box-shadow: inset 0 0 0 2.5px #ffffff, 0 0 0 2px var(--fg); }
  .tag-color-opt.sel::after { content: '✓'; }

  /* Reuse-a-tag button and picker */
  .use-tag-btn { padding: 4px 12px; border: 1px solid var(--line); border-radius: 999px;
                 background: transparent; color: var(--muted); font-family: inherit; font-size: 12px;
                 cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .use-tag-btn:hover { border-color: var(--fg); color: var(--fg); }
  .use-tag-btn[hidden] { display: none; }
  .tag-pick-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag-pick-opt { padding: 3px 12px; border: 0; border-radius: 999px; font-family: inherit;
                  font-size: 12px; font-weight: 600; color: #fff; cursor: pointer;
                  transition: box-shadow 0.15s, transform 0.15s; }
  .tag-pick-opt:hover { transform: scale(1.05); }
  .tag-pick-opt.sel { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--fg); }
  .tag-pick-empty { font-size: 12px; color: var(--muted); }
  .tag-panel-actions { display: flex; gap: 8px; }
  .tag-panel-actions button { flex: 1; padding: 8px 0; border: 0; border-radius: 10px; font-family: inherit;
                              font-size: 13px; font-weight: 600; cursor: pointer; transition: opacity 0.15s; }
  .tag-panel-actions button:hover { opacity: 0.8; }
  .tag-save { background: var(--fg); color: var(--bg); }
  .tag-cancel { background: transparent; color: var(--muted); }

  #journal-page textarea { flex: 1; width: 100%; border: 0; outline: none; resize: none;
                           background: transparent; font-family: 'Times New Roman', Times, serif;
                           font-size: 20px; line-height: 1.6; color: var(--fg); user-select: text; }

  /* Back arrow, top right (inside views with sidebar) */
  .back { position: absolute; top: 16px; right: 16px; width: 36px; height: 36px; border: 0;
          background: transparent; cursor: pointer; color: var(--fg);
          display: flex; align-items: center; justify-content: center; z-index: 5; }
  .back:hover { opacity: 0.6; }

  /* === Placeholder pages === */
  .placeholder { flex-direction: column; align-items: center; justify-content: center; gap: 12px; }
  .placeholder h2 { margin: 0; font-size: 28px; font-weight: 700; }
  .placeholder p { margin: 0; color: var(--muted); }

  /* === Light / dark toggle, bottom left === */
  #toggle { position: fixed; bottom: 20px; left: 24px; display: flex; gap: 4px; padding: 4px;
            border-radius: 999px; background: var(--card); z-index: 10; }
  #toggle button { width: 40px; height: 32px; border: 0; border-radius: 999px; cursor: pointer;
                   display: flex; align-items: center; justify-content: center;
                   background: transparent; color: var(--fg); opacity: 0.4; transition: opacity 0.15s, background 0.15s; }
  #toggle button.active { opacity: 1; background: var(--bg); }

  /* === Launch intro === */
  .brand { transition: opacity 0.3s ease; }
  .brand.intro-hidden { opacity: 0; }
  #intro { position: fixed; inset: 0; z-index: 1000; background: #000000; transition: background 0.8s ease; }
  #intro.reveal { background: transparent; }
  #intro .ring { position: absolute; left: 50%; top: 50%; width: 460px; height: 460px;
                 transform: translate(-50%, -50%); overflow: visible; transition: opacity 0.4s ease; }
  #intro.rings-out .ring { opacity: 0; }
  #intro .ring path { fill: none; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  /* Both layers draw the same path with the same timing, so the loop is one unbroken ink-like stroke:
     a quick confident sweep that settles softly at the end. */
  #intro .ring.back { z-index: 1; filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.12)); }
  #intro .ring.front { z-index: 3; filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.35)); }
  #intro .ring path { stroke-width: 3;
                      animation: ring-draw 0.9s cubic-bezier(0.65, 0, 0.25, 1) 0.3s forwards; }
  /* The half of the loop that passes behind the e reads as the far side, so it sits back in shadow. */
  #intro .ring.back path { stroke: #6e6e6e; }
  #intro .ring.front path { stroke: #ffffff; }
  @keyframes ring-draw { to { stroke-dashoffset: 0; } }
  #intro-e { position: absolute; left: calc(50% - 191px); top: calc(50% - 120px); width: 400px; height: 240px;
             z-index: 2; overflow: visible; transform-origin: 0 0; }
  #intro-e text { transform-box: fill-box; transform-origin: center; animation: intro-e-in 0.4s ease-out both; }
  @keyframes intro-e-in { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
  /* The dot blinks once the e has landed back in the brand mark: four flashes over 1s,
     with each gap between them a little longer than the last, so it settles rather than stops. */
  #brand-logo.dot-blink circle { animation: brand-dot-blink 1s steps(1, end) 1; }
  @keyframes brand-dot-blink {
    0% { opacity: 0; }  7% { opacity: 1; }
   19% { opacity: 0; } 26% { opacity: 1; }
   44% { opacity: 0; } 51% { opacity: 1; }
   75% { opacity: 0; } 82% { opacity: 1; }
  100% { opacity: 1; }
  }

  /* Rename inline input */
  .rename-input { padding: 4px 10px; border: 1px solid var(--fg); border-radius: 6px; font-size: 13px;
                  font-family: inherit; background: var(--bg); color: var(--fg); outline: none; width: 140px; }
</style>
</head>
<body>
  <!-- Launch intro: big e with a ring drawn behind, then in front of it -->
  <div id="intro" aria-hidden="true">
    <!-- One full ring behind the e; an identical copy in front, clipped to its near (lower) half -->
    <svg class="ring back" viewBox="0 0 460 460">
      <g transform="rotate(-18 230 230)">
        <path pathLength="1" d="M20 230 A210 58 0 0 1 440 230 A210 58 0 0 1 20 230"/>
      </g>
    </svg>
    <!-- Same 40x24 box as the brand logo, drawn 10x larger so it can shrink straight into it -->
    <svg id="intro-e" viewBox="0 0 40 24" fill="#ffffff">
      <text x="13" y="20" font-family="Helvetica, Arial, sans-serif" font-size="22" font-weight="700">e</text>
    </svg>
    <svg class="ring front" viewBox="0 0 460 460">
      <defs>
        <clipPath id="ring-front-clip"><rect x="0" y="230" width="460" height="230"/></clipPath>
      </defs>
      <g transform="rotate(-18 230 230)">
        <path pathLength="1" clip-path="url(#ring-front-clip)" d="M20 230 A210 58 0 0 1 440 230 A210 58 0 0 1 20 230"/>
      </g>
    </svg>
  </div>

  <!-- Brand -->
  <div class="brand intro-hidden" id="brand-home">
    <svg id="brand-logo" viewBox="0 0 40 24" width="40" height="24" fill="currentColor" aria-hidden="true">
      <circle cx="5" cy="14" r="3"/>
      <text x="13" y="20" font-family="Helvetica, Arial, sans-serif" font-size="22" font-weight="700">e</text>
    </svg>
    <span>Ethos</span>
  </div>

  <!-- Right sidebar -->
  <nav class="sidebar">
    <button class="sidebar-btn" data-view="journals"><span>J</span><span class="full">Journals</span></button>
    <button class="sidebar-btn" data-view="schedule-page"><span>S</span><span class="full">Schedule</span></button>
    <button class="sidebar-btn" data-view="habit-page"><span>H</span><span class="full">Habit tracker</span></button>
  </nav>

  <!-- Homepage -->
  <section id="home" class="view active">
    <h1>Homepage</h1>
    <p class="subtitle">Welcome back.</p>
  </section>

  <!-- Journals list -->
  <section id="journals" class="view">
    <button class="back" id="back-from-journals" title="Back" aria-label="Back">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <h1>Journals</h1>
    <button class="new-page-btn" id="new-page-btn">+ New page</button>
    <div class="pages-grid" id="pages-grid"></div>
  </section>

  <!-- Single journal page -->
  <section id="journal-page" class="view">
    <button class="back" id="back-from-journal" title="Back" aria-label="Back">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="jp-header">
      <input class="jp-title" id="jp-title" type="text" value="Untitled" spellcheck="false"/>
    </div>
    <div class="jp-tag-row" id="jp-tag-row">
      <button class="create-tag-btn" id="create-tag-btn">
        + Create a tag
        <span class="create-tag-tooltip">Organise your notes.</span>
      </button>
      <button class="use-tag-btn" id="use-tag-btn" type="button" hidden>Use other tag</button>
    </div>
    <div class="tag-panel" id="tag-panel">
      <input type="text" id="tag-name-input" placeholder="Tag name" maxlength="24"/>
      <div class="tag-colors" id="tag-colors"></div>
      <div class="tag-panel-actions">
        <button class="tag-cancel" id="tag-cancel">Cancel</button>
        <button class="tag-save" id="tag-save">Save</button>
      </div>
    </div>
    <div class="tag-panel" id="tag-pick-panel">
      <div class="tag-pick-list" id="tag-pick-list"></div>
    </div>
    <textarea id="jp-textarea" placeholder="Start writing..."></textarea>
  </section>

  <!-- Schedule placeholder -->
  <section id="schedule-page" class="view placeholder">
    <button class="back" data-back="home" title="Back" aria-label="Back">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <h2>Schedule</h2>
    <p>Coming soon.</p>
  </section>

  <!-- Habit tracker placeholder -->
  <section id="habit-page" class="view placeholder">
    <button class="back" data-back="home" title="Back" aria-label="Back">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <h2>Habit tracker</h2>
    <p>Coming soon.</p>
  </section>

  <!-- Bottom panel -->
  <div class="habit-bar">
    <h2>Habit tracker</h2>
    <p>Your habits will appear here.</p>
  </div>

  <!-- Light / dark toggle -->
  <div id="toggle">
    <button id="sun" title="Light mode" aria-label="Light mode">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
    </button>
    <button id="night" title="Dark mode" aria-label="Dark mode">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
      </svg>
    </button>
  </div>

<script>
  // ─── Data ───
  const TAG_COLORS = ['#3b82f6','#ef4444','#22c55e','#f59e0b','#8b5cf6','#ec4899','#14b8a6','#f97316'];
  let pages = [];       // { id, name, content, tag: { name, color } | null }
  let savedTags = [];   // every tag created so far, reusable from any page: { name, color }
  let currentPageId = null;
  let ctxMenu = null;

  // ─── Views ───
  const viewEls = {};
  document.querySelectorAll('.view').forEach(v => viewEls[v.id] = v);

  function show(name) {
    for (const key in viewEls) viewEls[key].classList.toggle('active', key === name);
    document.querySelectorAll('.sidebar-btn').forEach(b => b.classList.toggle('active', b.dataset.view === name));
    closeCtx();
  }

  // ─── Sidebar navigation ───
  document.querySelectorAll('.sidebar-btn').forEach(btn => {
    btn.addEventListener('click', () => show(btn.dataset.view));
  });

  // Brand goes home
  document.getElementById('brand-home').addEventListener('click', () => show('home'));
  document.getElementById('brand-home').style.cursor = 'pointer';

  // Back buttons
  document.getElementById('back-from-journals').addEventListener('click', () => show('home'));
  document.getElementById('back-from-journal').addEventListener('click', () => {
    saveCurrentPage();
    show('journals');
  });
  document.querySelectorAll('[data-back]').forEach(btn => {
    btn.addEventListener('click', () => show(btn.dataset.back));
  });

  // ─── Journals list ───
  const pagesGrid = document.getElementById('pages-grid');

  function renderPages() {
    pagesGrid.innerHTML = '';
    pages.forEach(p => {
      const card = document.createElement('div');
      card.className = 'page-card';
      card.innerHTML = '<p class="name"></p>';
      card.querySelector('.name').textContent = p.name;
      if (p.tag) {
        const pill = document.createElement('span');
        pill.className = 'tag-pill';
        pill.textContent = p.tag.name;
        pill.style.background = p.tag.color;
        card.appendChild(pill);
      }
      card.addEventListener('click', () => openPage(p.id));
      card.addEventListener('contextmenu', (e) => { e.preventDefault(); showCtx(e, p); });
      pagesGrid.appendChild(card);
    });
  }

  document.getElementById('new-page-btn').addEventListener('click', () => {
    const id = Date.now();
    pages.push({ id, name: 'Untitled', content: '', tag: null });
    renderPages();
    openPage(id);
  });

  function openPage(id) {
    saveCurrentPage();
    currentPageId = id;
    const p = pages.find(x => x.id === id);
    if (!p) return;
    document.getElementById('jp-title').value = p.name;
    document.getElementById('jp-textarea').value = p.content;
    renderPageTags();
    closePanels();
    show('journal-page');
  }

  function saveCurrentPage() {
    if (currentPageId == null) return;
    const p = pages.find(x => x.id === currentPageId);
    if (!p) return;
    p.name = document.getElementById('jp-title').value.trim() || 'Untitled';
    p.content = document.getElementById('jp-textarea').value;
    renderPages();
  }

  // ─── Right-click context menu ───
  function showCtx(e, page) {
    closeCtx();
    ctxMenu = document.createElement('div');
    ctxMenu.className = 'ctx-menu';

    const rename = document.createElement('div');
    rename.textContent = 'Rename';
    rename.addEventListener('click', () => { closeCtx(); startRename(page); });
    ctxMenu.appendChild(rename);

    const del = document.createElement('div');
    del.textContent = 'Delete';
    del.addEventListener('click', () => { closeCtx(); pages = pages.filter(x => x.id !== page.id); renderPages(); });
    ctxMenu.appendChild(del);

    ctxMenu.style.left = e.clientX + 'px';
    ctxMenu.style.top = e.clientY + 'px';
    document.body.appendChild(ctxMenu);
  }

  function closeCtx() { if (ctxMenu) { ctxMenu.remove(); ctxMenu = null; } }
  document.addEventListener('click', closeCtx);

  function startRename(page) {
    const card = [...pagesGrid.children].find(c => c.querySelector('.name').textContent === page.name);
    if (!card) return;
    const nameEl = card.querySelector('.name');
    const input = document.createElement('input');
    input.className = 'rename-input';
    input.value = page.name;
    nameEl.replaceWith(input);
    input.focus();
    input.select();
    const finish = () => {
      page.name = input.value.trim() || 'Untitled';
      renderPages();
    };
    input.addEventListener('blur', finish);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') input.blur(); });
    // Stop card click from opening the page
    input.addEventListener('click', (e) => e.stopPropagation());
  }

  // ─── Tags inside journal page ───
  function renderPageTags() {
    const row = document.getElementById('jp-tag-row');
    row.querySelectorAll('.jp-tag-pill').forEach(el => el.remove());
    const p = pages.find(x => x.id === currentPageId);
    if (p && p.tag) {
      const pill = document.createElement('span');
      pill.className = 'jp-tag-pill';
      pill.textContent = p.tag.name;
      pill.style.background = p.tag.color;
      row.insertBefore(pill, document.getElementById('create-tag-btn'));
    }
    syncUseTagBtn();
  }

  // Tag creation
  const tagPanel = document.getElementById('tag-panel');
  const tagPickPanel = document.getElementById('tag-pick-panel');
  const tagColorsEl = document.getElementById('tag-colors');
  const tagPickList = document.getElementById('tag-pick-list');
  const useTagBtn = document.getElementById('use-tag-btn');
  let selectedTagColor = TAG_COLORS[0];

  // Only one of the two panels is ever open.
  function openPanel(which) {
    tagPanel.classList.toggle('open', which === 'create');
    tagPickPanel.classList.toggle('open', which === 'pick');
  }
  function closePanels() { openPanel(null); }

  function markColor(color) {
    selectedTagColor = color;
    tagColorsEl.querySelectorAll('.tag-color-opt')
      .forEach(x => x.classList.toggle('sel', x.dataset.color === color));
  }

  TAG_COLORS.forEach(c => {
    const d = document.createElement('button');
    d.type = 'button';
    d.className = 'tag-color-opt';
    // Compared by data-color, not style.background: the browser rewrites inline colours to rgb().
    d.dataset.color = c;
    d.style.background = c;
    d.setAttribute('aria-label', 'Tag colour ' + c);
    d.addEventListener('click', () => markColor(c));
    tagColorsEl.appendChild(d);
  });
  markColor(TAG_COLORS[0]);

  // ─── Saved tag library, shared by every page ───
  function rememberTag(tag) {
    const i = savedTags.findIndex(t => t.name.toLowerCase() === tag.name.toLowerCase());
    if (i === -1) savedTags.push({ name: tag.name, color: tag.color });
    else savedTags[i] = { name: tag.name, color: tag.color };
  }

  function renderTagPicker() {
    const p = pages.find(x => x.id === currentPageId);
    tagPickList.innerHTML = '';
    savedTags.forEach(t => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'tag-pick-opt' + (p && p.tag && p.tag.name === t.name ? ' sel' : '');
      b.textContent = t.name;
      b.style.background = t.color;
      b.addEventListener('click', () => {
        const page = pages.find(x => x.id === currentPageId);
        if (page) page.tag = { name: t.name, color: t.color };
        closePanels();
        renderPageTags();
        renderPages();
      });
      tagPickList.appendChild(b);
    });
  }

  function syncUseTagBtn() { useTagBtn.hidden = savedTags.length === 0; }

  useTagBtn.addEventListener('click', () => {
    const opening = !tagPickPanel.classList.contains('open');
    if (opening) renderTagPicker();
    openPanel(opening ? 'pick' : null);
  });

  document.getElementById('create-tag-btn').addEventListener('click', () => {
    const opening = !tagPanel.classList.contains('open');
    if (opening) {
      document.getElementById('tag-name-input').value = '';
      markColor(TAG_COLORS[0]);
    }
    openPanel(opening ? 'create' : null);
  });

  document.getElementById('tag-cancel').addEventListener('click', closePanels);
  document.getElementById('tag-save').addEventListener('click', () => {
    const name = document.getElementById('tag-name-input').value.trim();
    if (!name) return;
    const tag = { name, color: selectedTagColor };
    rememberTag(tag);
    const p = pages.find(x => x.id === currentPageId);
    if (p) { p.tag = { name: tag.name, color: tag.color }; }
    closePanels();
    renderPageTags();
    renderPages();
  });

  // Title input syncs the page name live
  document.getElementById('jp-title').addEventListener('input', () => {
    const p = pages.find(x => x.id === currentPageId);
    if (p) p.name = document.getElementById('jp-title').value.trim() || 'Untitled';
  });

  // ─── Light / dark toggle ───
  const sunBtn = document.getElementById('sun');
  const nightBtn = document.getElementById('night');
  function setMode(mode) {
    const dark = mode === 'dark';
    document.body.classList.toggle('dark', dark);
    sunBtn.classList.toggle('active', !dark);
    nightBtn.classList.toggle('active', dark);
  }
  sunBtn.addEventListener('click', () => setMode('light'));
  nightBtn.addEventListener('click', () => setMode('dark'));
  setMode('dark');

  // ─── Launch intro ───
  // Timeline (ms): e fades in 0-400, ring draws 300-1200, ring fades 1500,
  // e shrinks into the logo 1800-2600, logo takes over 2600.
  (function playIntro() {
    const intro = document.getElementById('intro');
    const introE = document.getElementById('intro-e');
    const brand = document.getElementById('brand-home');
    const brandLogo = document.getElementById('brand-logo');

    function finish() {
      brand.classList.remove('intro-hidden');
      intro.remove();
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return finish();

    // Center the e's visible ink (not its text box) on the ring's center.
    // The intro svg draws the logo at 10x, so the glyph sits at x=130, baseline y=200.
    const ctx = document.createElement('canvas').getContext('2d');
    ctx.font = 'bold 220px Helvetica, Arial, sans-serif';
    const m = ctx.measureText('e');
    const inkX = 130 + (m.actualBoundingBoxRight - m.actualBoundingBoxLeft) / 2;
    const inkY = 200 + (m.actualBoundingBoxDescent - m.actualBoundingBoxAscent) / 2;
    introE.style.left = 'calc(50% - ' + inkX + 'px)';
    introE.style.top = 'calc(50% - ' + inkY + 'px)';

    setTimeout(() => intro.classList.add('rings-out'), 1500);

    setTimeout(() => {
      const from = introE.getBoundingClientRect();
      const to = brandLogo.getBoundingClientRect();
      const scale = to.width / from.width;
      introE.style.transition = 'transform 0.8s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.3s ease';
      introE.style.transform =
        'translate(' + (to.left - from.left) + 'px, ' + (to.top - from.top) + 'px) scale(' + scale + ')';
      intro.classList.add('reveal');
    }, 1800);

    setTimeout(() => {
      brand.classList.remove('intro-hidden');
      introE.style.opacity = '0';
      brandLogo.classList.add('dot-blink');
      setTimeout(() => brandLogo.classList.remove('dot-blink'), 1000);
    }, 2600);

    setTimeout(finish, 2900);
  })();
</script>
</body>
</html>`;

function createWindow() {
  const win = new BrowserWindow({
    width: 1000,
    height: 700,
    minWidth: 400,
    minHeight: 300,
    title: 'Ethos',
    backgroundColor: '#000000',
    autoHideMenuBar: true,
  });

  win.loadURL('data:text/html;charset=utf-8,' + encodeURIComponent(PAGE));

  // In-app notifications live in their own file; inject them into the loaded page.
  win.webContents.on('did-finish-load', () => {
    try {
      const notif = fs.readFileSync(path.join(__dirname, 'notifications.js'), 'utf8');
      win.webContents.executeJavaScript(notif);
    } catch (err) {
      console.error('notifications.js not loaded:', err.message);
    }
  });
}

app.whenReady().then(() => {
  createWindow();
  app.on('activate', () => {
    if (BrowserWindow.getAllWindows().length === 0) createWindow();
  });
});

app.on('window-all-closed', () => {
  app.quit();
});
