// Ethos in-app notifications — toast stack rendered by the app itself, not the OS.
// This file runs in the renderer; main.js injects it once the page has loaded.
// Nothing here touches main.js state, so notification segments can be built on top
// of the API below without editing the page markup.
//
//   EthosNotify.show({ title, message, type, duration, action })
//   EthosNotify.show('Title', 'Message', { type: 'success' })
//   EthosNotify.info / .success / .warn / .error  (title, message, opts)
//   EthosNotify.dismiss(id)        remove one toast
//   EthosNotify.clear()            remove everything, queue included
//
//   type      'info' | 'success' | 'warn' | 'error'   (default 'info')
//   duration  ms before it self-dismisses; 0 keeps it until dismissed
//   action    { label, onClick }  renders one compact inline button

(() => {
  if (window.EthosNotify) return;   // injected twice: keep the first one

  const ACCENT = {
    info:    '#3b82f6',
    success: '#22c55e',
    warn:    '#f59e0b',
    error:   '#ef4444',
  };
  const DEFAULT_TYPE = 'info';
  const DEFAULT_DURATION = 4000;
  const MAX_VISIBLE = 4;
  const ANIM_MS = 220;

  const CSS = `
  .ethos-notif-stack { position: fixed; right: 64px; bottom: 156px; width: 300px; z-index: 200;
                       display: flex; flex-direction: column-reverse; gap: 8px;
                       pointer-events: none; }

  .ethos-notif { position: relative; display: flex; align-items: flex-start; gap: 10px;
                 padding: 11px 12px 11px 14px; border: 1px solid var(--line); border-radius: 10px;
                 background: var(--card); color: var(--fg); overflow: hidden; max-height: 240px;
                 box-shadow: 0 6px 20px rgba(0,0,0,0.10); pointer-events: auto;
                 opacity: 0; transform: translateX(14px);
                 transition: opacity .22s ease, transform .22s ease, max-height .22s ease,
                             padding .22s ease, margin-top .22s ease; }
  .ethos-notif.in  { opacity: 1; transform: translateX(0); }
  .ethos-notif.out { opacity: 0; transform: translateX(14px); max-height: 0; margin-top: -8px;
                     padding-top: 0; padding-bottom: 0; border-top-width: 0; border-bottom-width: 0; }
  body.dark .ethos-notif { box-shadow: 0 6px 20px rgba(0,0,0,0.5); }

  .ethos-notif-accent { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }

  .ethos-notif-body { flex: 1; min-width: 0; }
  .ethos-notif-title { margin: 0; font-size: 13px; font-weight: 600; line-height: 1.35;
                       overflow-wrap: break-word; }
  .ethos-notif-msg { margin: 3px 0 0; font-size: 12px; line-height: 1.45; color: var(--muted);
                     overflow-wrap: break-word; }
  .ethos-notif-action { margin: 8px 0 0; padding: 0; border: 0; background: transparent;
                        color: var(--fg); font-family: inherit; font-size: 12px; font-weight: 600;
                        cursor: pointer; opacity: 0.85; transition: opacity .15s; }
  .ethos-notif-action:hover { opacity: 1; text-decoration: underline; }

  .ethos-notif-close { flex: none; width: 20px; height: 20px; margin: -2px -2px 0 0; padding: 0;
                       border: 0; border-radius: 6px; background: transparent; color: var(--muted);
                       cursor: pointer; display: flex; align-items: center; justify-content: center;
                       opacity: 0; transition: opacity .15s, background .15s, color .15s; }
  .ethos-notif:hover .ethos-notif-close { opacity: 1; }
  .ethos-notif-close:hover { background: var(--hover); color: var(--fg); }
  .ethos-notif-close:focus-visible { opacity: 1; outline: 1px solid var(--fg); }

  .ethos-notif-timer { position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
                       transform-origin: left center; opacity: 0.35; }
  .ethos-notif:hover .ethos-notif-timer { animation-play-state: paused; }
  @keyframes ethos-notif-timer { from { transform: scaleX(1); } to { transform: scaleX(0); } }
  `;

  const style = document.createElement('style');
  style.id = 'ethos-notif-style';
  style.textContent = CSS;
  document.head.appendChild(style);

  const stack = document.createElement('div');
  stack.className = 'ethos-notif-stack';
  stack.setAttribute('role', 'status');
  stack.setAttribute('aria-live', 'polite');
  document.body.appendChild(stack);

  const live = new Map();   // id -> record
  const queue = [];
  let nextId = 1;

  const CLOSE_SVG =
    '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" ' +
    'stroke-width="2.2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>';

  function build(opts) {
    const type = ACCENT[opts.type] ? opts.type : DEFAULT_TYPE;
    const color = ACCENT[type];

    const el = document.createElement('div');
    el.className = 'ethos-notif';
    el.dataset.type = type;

    const accent = document.createElement('span');
    accent.className = 'ethos-notif-accent';
    accent.style.background = color;
    el.appendChild(accent);

    const body = document.createElement('div');
    body.className = 'ethos-notif-body';

    const title = document.createElement('p');
    title.className = 'ethos-notif-title';
    title.textContent = opts.title || '';
    body.appendChild(title);

    if (opts.message) {
      const msg = document.createElement('p');
      msg.className = 'ethos-notif-msg';
      msg.textContent = opts.message;
      body.appendChild(msg);
    }

    if (opts.action && opts.action.label) {
      const act = document.createElement('button');
      act.className = 'ethos-notif-action';
      act.textContent = opts.action.label;
      act.addEventListener('click', (e) => {
        e.stopPropagation();
        if (typeof opts.action.onClick === 'function') opts.action.onClick();
        dismiss(el.dataset.id);
      });
      body.appendChild(act);
    }
    el.appendChild(body);

    const close = document.createElement('button');
    close.className = 'ethos-notif-close';
    close.title = 'Dismiss';
    close.setAttribute('aria-label', 'Dismiss notification');
    close.innerHTML = CLOSE_SVG;
    close.addEventListener('click', (e) => { e.stopPropagation(); dismiss(el.dataset.id); });
    el.appendChild(close);

    return { el, color };
  }

  function present(opts) {
    const id = String(opts.id);
    const { el, color } = build(opts);
    el.dataset.id = id;

    const duration = Number.isFinite(opts.duration) ? opts.duration : DEFAULT_DURATION;
    const rec = { el, duration, remaining: duration, startedAt: 0, timer: null };

    if (duration > 0) {
      const bar = document.createElement('span');
      bar.className = 'ethos-notif-timer';
      bar.style.background = color;
      bar.style.animation = `ethos-notif-timer ${duration}ms linear forwards`;
      el.appendChild(bar);

      const pause = () => {
        if (rec.timer == null) return;
        clearTimeout(rec.timer);
        rec.timer = null;
        rec.remaining = Math.max(0, rec.remaining - (Date.now() - rec.startedAt));
      };
      const resume = () => {
        if (rec.timer != null) return;
        rec.startedAt = Date.now();
        rec.timer = setTimeout(() => dismiss(id), rec.remaining);
      };
      el.addEventListener('mouseenter', pause);
      el.addEventListener('mouseleave', resume);
      rec.resume = resume;
    }

    live.set(id, rec);
    stack.appendChild(el);
    requestAnimationFrame(() => el.classList.add('in'));
    if (rec.resume) rec.resume();
    return id;
  }

  function pump() {
    while (queue.length && live.size < MAX_VISIBLE) present(queue.shift());
  }

  function show(a, b, c) {
    let opts;
    if (typeof a === 'string') opts = Object.assign({}, c, { title: a, message: b });
    else opts = Object.assign({}, a);

    opts.id = nextId++;
    if (live.size >= MAX_VISIBLE) queue.push(opts);
    else present(opts);
    return String(opts.id);
  }

  function dismiss(id) {
    id = String(id);
    const rec = live.get(id);
    if (!rec) return false;
    if (rec.timer != null) clearTimeout(rec.timer);
    live.delete(id);
    rec.el.classList.remove('in');
    rec.el.classList.add('out');
    setTimeout(() => { rec.el.remove(); pump(); }, ANIM_MS);
    return true;
  }

  function clear() {
    queue.length = 0;
    [...live.keys()].forEach(dismiss);
  }

  const byType = (type) => (title, message, opts) =>
    show(Object.assign({}, opts, { title, message, type }));

  window.EthosNotify = {
    show,
    dismiss,
    clear,
    info: byType('info'),
    success: byType('success'),
    warn: byType('warn'),
    error: byType('error'),
    get count() { return live.size; },
    get queued() { return queue.length; },
  };
})();
